# Which model provider the agent uses.
#   stub   - deterministic offline canned responses (default; used by CI and `make eval`)
#   openai - OPENAI_API_KEY required
#   vertex - GOOGLE_CLOUD_PROJECT + application default credentials required
PROVIDER=stub

# Caller identity for local runs. Roles: employee | sre
# `intern` is treated as `employee`.
PSA_ROLE=employee
PSA_USER=demo@meridiancloud.example

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
VERTEX_MODEL=gemini-2.0-flash

# Retrieval
PSA_TOP_K=4
PSA_MIN_SCORE=0.15
